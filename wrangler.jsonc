{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "star-t-gate-inbox",
  "main": "src/index.js",
  "compatibility_date": "2026-10-30",
  "vars": {
    "GITHUB_OWNER": "gschmidtke",
    "GITHUB_REPO": "STAR-T-GATE-INBOX"
  },
  "secrets": {
    "required": [
      "GITHUB_TOKEN"
    ]
  }
}